<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_MedicionFacturacion" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_MedicionFacturacion">
    <bpmn:participant id="Participant_MedicionFacturacion" name="GAS COROCORA - Gestión de Medición y Facturación" processRef="Proceso_MedicionFacturacion" />
    <bpmn:participant id="Participant_UsuarioFacturacion" name="Usuario / Suscriptor" />
    <bpmn:participant id="Participant_EntidadRecaudadora" name="Entidad recaudadora (banco / portal de pagos)" />
    <bpmn:messageFlow id="MessageFlow_Factura" name="Factura" sourceRef="Activity_EnviarFactura" targetRef="Participant_UsuarioFacturacion" />
    <bpmn:messageFlow id="MessageFlow_ConfirmacionPago" name="Confirmación de pago" sourceRef="Participant_EntidadRecaudadora" targetRef="Event_PagoRecibido" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_MedicionFacturacion" name="Gestión de Medición y Facturación" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>P4 del portafolio GAS COROCORA. Cuantifica el consumo, liquida la factura según estrato (DMN), la envía al usuario (External Task JS) y espera el pago o el vencimiento del plazo.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_MedicionFacturacion">
      <bpmn:lane id="Lane_AnalistaFacturacion" name="Analista de facturación">
        <bpmn:flowNodeRef>StartEvent_CicloFacturacionIniciado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RevisarLiquidacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PlazoPagoVencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_GestionarSuspension</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ServicioSuspendido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LectorCampo" name="Lector de campo">
        <bpmn:flowNodeRef>Activity_RegistrarLectura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_VerificarLectura</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SistemaComercialFacturacion" name="Sistema comercial">
        <bpmn:flowNodeRef>Activity_CalcularConsumo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LecturaConsistente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_DeterminarFactorTarifario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_LiquidarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EnviarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperarPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PagoRecibido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RegistrarPago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FacturaPagada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_CicloFacturacionIniciado" name="Ciclo de facturación iniciado" camunda:formRef="formIniciarCicloFacturacion" camunda:formRefBinding="latest" camunda:initiator="iniciador">
      <bpmn:outgoing>Flow_InicioARegistrarLectura</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_RegistrarLectura" name="Registrar lectura del medidor" camunda:formRef="formRegistrarLectura" camunda:formRefBinding="latest" camunda:candidateGroups="lectoresCampo">
      <bpmn:incoming>Flow_InicioARegistrarLectura</bpmn:incoming>
      <bpmn:outgoing>Flow_LecturaACalcularConsumo</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_CalcularConsumo" name="Calcular consumo y desviación" camunda:class="com.gascorocora.implementations.facturacion.CalcularConsumoDelegate">
      <bpmn:incoming>Flow_LecturaACalcularConsumo</bpmn:incoming>
      <bpmn:incoming>Flow_LecturaVerificada</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsumoAValidacion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LecturaConsistente" name="¿Lectura consistente?">
      <bpmn:incoming>Flow_ConsumoAValidacion</bpmn:incoming>
      <bpmn:outgoing>Flow_LecturaInconsistente</bpmn:outgoing>
      <bpmn:outgoing>Flow_LecturaConsistente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_VerificarLectura" name="Verificar lectura en terreno" camunda:formRef="formVerificarLectura" camunda:formRefBinding="latest" camunda:candidateGroups="lectoresCampo">
      <bpmn:incoming>Flow_LecturaInconsistente</bpmn:incoming>
      <bpmn:outgoing>Flow_LecturaVerificada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Activity_DeterminarFactorTarifario" name="Determinar factor tarifario por estrato" camunda:decisionRef="Decision_FactorTarifario" camunda:decisionRefBinding="latest" camunda:resultVariable="porcentajeAjuste" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_LecturaConsistente</bpmn:incoming>
      <bpmn:outgoing>Flow_FactorALiquidar</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_LiquidarFactura" name="Liquidar factura" camunda:delegateExpression="#{liquidarFacturaDelegate}">
      <bpmn:incoming>Flow_FactorALiquidar</bpmn:incoming>
      <bpmn:outgoing>Flow_LiquidarARevisar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_RevisarLiquidacion" name="Revisar liquidación de la factura" camunda:formRef="formRevisarLiquidacion" camunda:formRefBinding="latest" camunda:candidateGroups="analistasFacturacion">
      <bpmn:incoming>Flow_LiquidarARevisar</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisarAEnviar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_EnviarFactura" name="Enviar factura al usuario" camunda:type="external" camunda:topic="EnviarFactura">
      <bpmn:incoming>Flow_RevisarAEnviar</bpmn:incoming>
      <bpmn:outgoing>Flow_EnviarAEsperarPago</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_EsperarPago" name="¿Pago o vencimiento?">
      <bpmn:incoming>Flow_EnviarAEsperarPago</bpmn:incoming>
      <bpmn:outgoing>Flow_EsperarAPago</bpmn:outgoing>
      <bpmn:outgoing>Flow_EsperarAVencimiento</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_PagoRecibido" name="Pago recibido">
      <bpmn:incoming>Flow_EsperarAPago</bpmn:incoming>
      <bpmn:outgoing>Flow_PagoARegistrar</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PagoRecibido" messageRef="Message_PagoRecibido" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PlazoPagoVencido" name="Plazo de pago vencido">
      <bpmn:incoming>Flow_EsperarAVencimiento</bpmn:incoming>
      <bpmn:outgoing>Flow_VencimientoASuspension</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_PlazoPago">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazosProceso.pagoFactura}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_RegistrarPago" name="Registrar pago y actualizar cartera" camunda:class="com.gascorocora.implementations.facturacion.RegistrarPagoDelegate">
      <bpmn:incoming>Flow_PagoARegistrar</bpmn:incoming>
      <bpmn:outgoing>Flow_RegistrarAFin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_FacturaPagada" name="Factura pagada">
      <bpmn:incoming>Flow_RegistrarAFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="CallActivity_GestionarSuspension" name="Gestionar suspensión por mora" calledElement="Proceso_SuspensionServicio" camunda:calledElementBinding="latest">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_VencimientoASuspension</bpmn:incoming>
      <bpmn:outgoing>Flow_SuspensionAFin</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_ServicioSuspendido" name="Suspensión por mora gestionada">
      <bpmn:incoming>Flow_SuspensionAFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_InicioARegistrarLectura" sourceRef="StartEvent_CicloFacturacionIniciado" targetRef="Activity_RegistrarLectura" />
    <bpmn:sequenceFlow id="Flow_LecturaACalcularConsumo" sourceRef="Activity_RegistrarLectura" targetRef="Activity_CalcularConsumo" />
    <bpmn:sequenceFlow id="Flow_ConsumoAValidacion" sourceRef="Activity_CalcularConsumo" targetRef="Gateway_LecturaConsistente" />
    <bpmn:sequenceFlow id="Flow_LecturaInconsistente" name="No" sourceRef="Gateway_LecturaConsistente" targetRef="Activity_VerificarLectura">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiereVerificacion}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LecturaVerificada" sourceRef="Activity_VerificarLectura" targetRef="Activity_CalcularConsumo" />
    <bpmn:sequenceFlow id="Flow_LecturaConsistente" name="Sí" sourceRef="Gateway_LecturaConsistente" targetRef="Activity_DeterminarFactorTarifario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!requiereVerificacion}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FactorALiquidar" sourceRef="Activity_DeterminarFactorTarifario" targetRef="Activity_LiquidarFactura" />
    <bpmn:sequenceFlow id="Flow_LiquidarARevisar" sourceRef="Activity_LiquidarFactura" targetRef="Activity_RevisarLiquidacion" />
    <bpmn:sequenceFlow id="Flow_RevisarAEnviar" sourceRef="Activity_RevisarLiquidacion" targetRef="Activity_EnviarFactura" />
    <bpmn:sequenceFlow id="Flow_EnviarAEsperarPago" sourceRef="Activity_EnviarFactura" targetRef="Gateway_EsperarPago" />
    <bpmn:sequenceFlow id="Flow_EsperarAPago" sourceRef="Gateway_EsperarPago" targetRef="Event_PagoRecibido" />
    <bpmn:sequenceFlow id="Flow_EsperarAVencimiento" sourceRef="Gateway_EsperarPago" targetRef="Event_PlazoPagoVencido" />
    <bpmn:sequenceFlow id="Flow_PagoARegistrar" sourceRef="Event_PagoRecibido" targetRef="Activity_RegistrarPago" />
    <bpmn:sequenceFlow id="Flow_RegistrarAFin" sourceRef="Activity_RegistrarPago" targetRef="End_FacturaPagada" />
    <bpmn:sequenceFlow id="Flow_VencimientoASuspension" sourceRef="Event_PlazoPagoVencido" targetRef="CallActivity_GestionarSuspension" />
    <bpmn:sequenceFlow id="Flow_SuspensionAFin" sourceRef="CallActivity_GestionarSuspension" targetRef="End_ServicioSuspendido" />
    <bpmn:textAnnotation id="TextAnnotation_ExternalFactura">
      <bpmn:text>External Task (JavaScript) topic: EnviarFactura</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TextAnnotation_ExternalFactura" sourceRef="Activity_EnviarFactura" targetRef="TextAnnotation_ExternalFactura" />
    <bpmn:textAnnotation id="TextAnnotation_PlazoPago">
      <bpmn:text>Plazo en application.yaml (demo PT5M, real P30D)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TextAnnotation_PlazoPago" sourceRef="Event_PlazoPagoVencido" targetRef="TextAnnotation_PlazoPago" />
  </bpmn:process>
  <bpmn:message id="Message_PagoRecibido" name="MensajePagoRecibido" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_MedicionFacturacion">
    <bpmndi:BPMNPlane id="BPMNPlane_MedicionFacturacion" bpmnElement="Collaboration_MedicionFacturacion">
      <bpmndi:BPMNShape id="Participant_MedicionFacturacion_di" bpmnElement="Participant_MedicionFacturacion" isHorizontal="true">
        <dc:Bounds x="150" y="190" width="1850" height="500" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AnalistaFacturacion_di" bpmnElement="Lane_AnalistaFacturacion" isHorizontal="true">
        <dc:Bounds x="180" y="190" width="1820" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_LectorCampo_di" bpmnElement="Lane_LectorCampo" isHorizontal="true">
        <dc:Bounds x="180" y="360" width="1820" height="160" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SistemaComercialFacturacion_di" bpmnElement="Lane_SistemaComercialFacturacion" isHorizontal="true">
        <dc:Bounds x="180" y="520" width="1820" height="170" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_UsuarioFacturacion_di" bpmnElement="Participant_UsuarioFacturacion" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1850" height="60" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_EntidadRecaudadora_di" bpmnElement="Participant_EntidadRecaudadora" isHorizontal="true">
        <dc:Bounds x="150" y="740" width="1850" height="60" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_CicloFacturacionIniciado_di" bpmnElement="StartEvent_CicloFacturacionIniciado">
        <dc:Bounds x="242" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="205" y="297" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistrarLectura_di" bpmnElement="Activity_RegistrarLectura">
        <dc:Bounds x="360" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CalcularConsumo_di" bpmnElement="Activity_CalcularConsumo">
        <dc:Bounds x="510" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LecturaConsistente_di" bpmnElement="Gateway_LecturaConsistente" isMarkerVisible="true">
        <dc:Bounds x="685" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="655" y="634" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_VerificarLectura_di" bpmnElement="Activity_VerificarLectura">
        <dc:Bounds x="660" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DeterminarFactorTarifario_di" bpmnElement="Activity_DeterminarFactorTarifario">
        <dc:Bounds x="810" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_LiquidarFactura_di" bpmnElement="Activity_LiquidarFactura">
        <dc:Bounds x="960" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RevisarLiquidacion_di" bpmnElement="Activity_RevisarLiquidacion">
        <dc:Bounds x="1110" y="235" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_EnviarFactura_di" bpmnElement="Activity_EnviarFactura">
        <dc:Bounds x="1260" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EsperarPago_di" bpmnElement="Gateway_EsperarPago">
        <dc:Bounds x="1435" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1405" y="634" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PagoRecibido_di" bpmnElement="Event_PagoRecibido">
        <dc:Bounds x="1592" y="587" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1555" y="627" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PlazoPagoVencido_di" bpmnElement="Event_PlazoPagoVencido">
        <dc:Bounds x="1592" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1555" y="297" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistrarPago_di" bpmnElement="Activity_RegistrarPago">
        <dc:Bounds x="1710" y="565" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FacturaPagada_di" bpmnElement="End_FacturaPagada">
        <dc:Bounds x="1892" y="587" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1855" y="627" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_GestionarSuspension_di" bpmnElement="CallActivity_GestionarSuspension">
        <dc:Bounds x="1710" y="235" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ServicioSuspendido_di" bpmnElement="End_ServicioSuspendido">
        <dc:Bounds x="1892" y="257" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1855" y="297" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_ExternalFactura_di" bpmnElement="TextAnnotation_ExternalFactura">
        <dc:Bounds x="1365" y="515" width="150" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_PlazoPago_di" bpmnElement="TextAnnotation_PlazoPago">
        <dc:Bounds x="1450" y="203" width="150" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_InicioARegistrarLectura_di" bpmnElement="Flow_InicioARegistrarLectura">
        <di:waypoint x="278" y="275" />
        <di:waypoint x="319" y="275" />
        <di:waypoint x="319" y="440" />
        <di:waypoint x="360" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LecturaACalcularConsumo_di" bpmnElement="Flow_LecturaACalcularConsumo">
        <di:waypoint x="460" y="440" />
        <di:waypoint x="485" y="440" />
        <di:waypoint x="485" y="605" />
        <di:waypoint x="510" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConsumoAValidacion_di" bpmnElement="Flow_ConsumoAValidacion">
        <di:waypoint x="610" y="605" />
        <di:waypoint x="685" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LecturaInconsistente_di" bpmnElement="Flow_LecturaInconsistente">
        <di:waypoint x="710" y="580" />
        <di:waypoint x="710" y="480" />
        <bpmndi:BPMNLabel><dc:Bounds x="715" y="523" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LecturaVerificada_di" bpmnElement="Flow_LecturaVerificada">
        <di:waypoint x="660" y="440" />
        <di:waypoint x="560" y="440" />
        <di:waypoint x="560" y="565" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LecturaConsistente_di" bpmnElement="Flow_LecturaConsistente">
        <di:waypoint x="735" y="605" />
        <di:waypoint x="810" y="605" />
        <bpmndi:BPMNLabel><dc:Bounds x="741" y="585" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FactorALiquidar_di" bpmnElement="Flow_FactorALiquidar">
        <di:waypoint x="910" y="605" />
        <di:waypoint x="960" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LiquidarARevisar_di" bpmnElement="Flow_LiquidarARevisar">
        <di:waypoint x="1060" y="605" />
        <di:waypoint x="1085" y="605" />
        <di:waypoint x="1085" y="275" />
        <di:waypoint x="1110" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RevisarAEnviar_di" bpmnElement="Flow_RevisarAEnviar">
        <di:waypoint x="1210" y="275" />
        <di:waypoint x="1235" y="275" />
        <di:waypoint x="1235" y="605" />
        <di:waypoint x="1260" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EnviarAEsperarPago_di" bpmnElement="Flow_EnviarAEsperarPago">
        <di:waypoint x="1360" y="605" />
        <di:waypoint x="1435" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EsperarAPago_di" bpmnElement="Flow_EsperarAPago">
        <di:waypoint x="1485" y="605" />
        <di:waypoint x="1592" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_EsperarAVencimiento_di" bpmnElement="Flow_EsperarAVencimiento">
        <di:waypoint x="1460" y="580" />
        <di:waypoint x="1460" y="275" />
        <di:waypoint x="1592" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PagoARegistrar_di" bpmnElement="Flow_PagoARegistrar">
