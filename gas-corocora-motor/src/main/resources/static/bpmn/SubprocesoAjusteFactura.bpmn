<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AjusteFactura" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.28.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="Collaboration_AjusteFactura">
    <bpmn:participant id="Participant_AjusteFactura" name="GAS COROCORA - Ajuste de factura" processRef="Proceso_AjusteFactura" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_AjusteFactura" name="Ajuste de Factura" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Subproceso invocado por Call Activity desde Atención al Usuario y PQRS.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_AjusteFactura">
      <bpmn:lane id="Lane_JefeServicioCliente" name="Jefe de servicio al cliente">
        <bpmn:flowNodeRef>StartEvent_AjusteSolicitado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AprobarAjuste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AjusteAprobado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AjusteRechazado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SistemaComercialAjuste" name="Sistema comercial">
        <bpmn:flowNodeRef>Activity_AplicarNotaCredito</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AjusteAplicado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_AjusteSolicitado" name="Ajuste solicitado">
      <bpmn:outgoing>Flow_SolicitadoAAprobar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_AprobarAjuste" name="Aprobar ajuste a la factura" camunda:formRef="formAprobarAjuste" camunda:formRefBinding="latest" camunda:candidateGroups="jefesServicioCliente">
      <bpmn:incoming>Flow_SolicitadoAAprobar</bpmn:incoming>
      <bpmn:outgoing>Flow_AprobarADecidir</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_AjusteAprobado" name="¿Ajuste aprobado?">
      <bpmn:incoming>Flow_AprobarADecidir</bpmn:incoming>
      <bpmn:outgoing>Flow_AjusteAprobado</bpmn:outgoing>
      <bpmn:outgoing>Flow_AjusteRechazado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_AplicarNotaCredito" name="Aplicar nota crédito" camunda:asyncBefore="true" camunda:delegateExpression="#{notaCreditoDelegate}">
      <bpmn:incoming>Flow_AjusteAprobado</bpmn:incoming>
      <bpmn:outgoing>Flow_NotaCreditoAFin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AjusteAplicado" name="Ajuste aplicado">
      <bpmn:incoming>Flow_NotaCreditoAFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_AjusteRechazado" name="Ajuste rechazado">
      <bpmn:incoming>Flow_AjusteRechazado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_SolicitadoAAprobar" sourceRef="StartEvent_AjusteSolicitado" targetRef="Activity_AprobarAjuste" />
    <bpmn:sequenceFlow id="Flow_AprobarADecidir" sourceRef="Activity_AprobarAjuste" targetRef="Gateway_AjusteAprobado" />
    <bpmn:sequenceFlow id="Flow_AjusteAprobado" name="Sí" sourceRef="Gateway_AjusteAprobado" targetRef="Activity_AplicarNotaCredito">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ajusteAprobado}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AjusteRechazado" name="No" sourceRef="Gateway_AjusteAprobado" targetRef="End_AjusteRechazado">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!ajusteAprobado}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotaCreditoAFin" sourceRef="Activity_AplicarNotaCredito" targetRef="End_AjusteAplicado" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AjusteFactura">
    <bpmndi:BPMNPlane id="BPMNPlane_AjusteFactura" bpmnElement="Collaboration_AjusteFactura">
      <bpmndi:BPMNShape id="Participant_AjusteFactura_di" bpmnElement="Participant_AjusteFactura" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="800" height="300" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_JefeServicioCliente_di" bpmnElement="Lane_JefeServicioCliente" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="770" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SistemaComercialAjuste_di" bpmnElement="Lane_SistemaComercialAjuste" isHorizontal="true">
        <dc:Bounds x="180" y="230" width="770" height="150" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_AjusteSolicitado_di" bpmnElement="StartEvent_AjusteSolicitado">
        <dc:Bounds x="242" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="205" y="177" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_AprobarAjuste_di" bpmnElement="Activity_AprobarAjuste">
        <dc:Bounds x="360" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AjusteAprobado_di" bpmnElement="Gateway_AjusteAprobado" isMarkerVisible="true">
        <dc:Bounds x="535" y="130" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="505" y="184" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_AplicarNotaCredito_di" bpmnElement="Activity_AplicarNotaCredito">
        <dc:Bounds x="660" y="265" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AjusteAplicado_di" bpmnElement="End_AjusteAplicado">
        <dc:Bounds x="842" y="287" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="805" y="327" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AjusteRechazado_di" bpmnElement="End_AjusteRechazado">
        <dc:Bounds x="692" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="655" y="177" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_SolicitadoAAprobar_di" bpmnElement="Flow_SolicitadoAAprobar">
        <di:waypoint x="278" y="155" />
        <di:waypoint x="360" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AprobarADecidir_di" bpmnElement="Flow_AprobarADecidir">
        <di:waypoint x="460" y="155" />
        <di:waypoint x="535" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AjusteAprobado_di" bpmnElement="Flow_AjusteAprobado">
        <di:waypoint x="560" y="180" />
        <di:waypoint x="560" y="305" />
        <di:waypoint x="660" y="305" />
        <bpmndi:BPMNLabel><dc:Bounds x="565" y="236" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AjusteRechazado_di" bpmnElement="Flow_AjusteRechazado">
        <di:waypoint x="585" y="155" />
        <di:waypoint x="692" y="155" />
        <bpmndi:BPMNLabel><dc:Bounds x="591" y="135" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotaCreditoAFin_di" bpmnElement="Flow_NotaCreditoAFin">
        <di:waypoint x="760" y="305" />
        <di:waypoint x="842" y="305" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
